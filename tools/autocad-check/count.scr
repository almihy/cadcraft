(defun cnt-add (k al / p) (if (setq p (assoc k al)) (subst (cons k (1+ (cdr p))) p al) (cons (cons k 1) al)))
(defun cnt ( / ss i n al e ed f lay blk anon t1 ps ins lo p)
  (setq al nil n 0 ins 0)
  (if (setq ss (ssget "_X" (list (cons 410 "Model"))))
    (progn (setq n (sslength ss) i 0)
      (while (< i n) (setq ed (entget (ssname ss i)) al (cnt-add (cdr (assoc 0 ed)) al) i (1+ i)))))
  (setq ps 0)
  (if (setq ss (ssget "_X" (list (cons 67 1)))) (setq ps (sslength ss)))
  (setq lay 0 t1 (tblnext "LAYER" T))
  (while t1 (setq lay (1+ lay) t1 (tblnext "LAYER")))
  (setq blk 0 anon 0 t1 (tblnext "BLOCK" T))
  (while t1 (if (= (substr (cdr (assoc 2 t1)) 1 1) "*") (setq anon (1+ anon)) (setq blk (1+ blk))) (setq t1 (tblnext "BLOCK")))
  (setq f (open (strcat (getvar "DWGPREFIX") (getvar "DWGNAME") ".acad.txt") "w"))
  (write-line (strcat "model " (itoa n)) f)
  (write-line (strcat "paper " (itoa ps)) f)
  (write-line (strcat "layers " (itoa lay)) f)
  (write-line (strcat "blocks " (itoa blk)) f)
  (write-line (strcat "anonblocks " (itoa anon)) f)
  (setq lo 0) (foreach p (dictsearch (namedobjdict) "ACAD_LAYOUT") (if (= (car p) 3) (setq lo (1+ lo))))
  (write-line (strcat "layouts " (itoa lo)) f)
  (write-line (strcat "insunits " (itoa (getvar "INSUNITS"))) f)
  (write-line (strcat "extmin " (rtos (car (getvar "EXTMIN")) 2 3) " " (rtos (cadr (getvar "EXTMIN")) 2 3)) f)
  (write-line (strcat "extmax " (rtos (car (getvar "EXTMAX")) 2 3) " " (rtos (cadr (getvar "EXTMAX")) 2 3)) f)
  (foreach p al (write-line (strcat "kind " (car p) " " (itoa (cdr p))) f))
  (close f) (princ))
_.AUDIT _N
(cnt)
